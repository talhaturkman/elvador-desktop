{
  "name": "elvador-desktop",
  "version": "0.25.13",
  "private": true,
  "description": "Elvador Windows desktop shell and native notification engine",
  "author": "Elvador",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis portable",
    "build:release": "electron-builder --win --dir --publish never && node scripts/write-app-update-yml.js && node scripts/post-build-icon.js && npx electron-builder --win nsis --prepackaged release/win-unpacked --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "42.3.3",
    "electron-builder": "26.8.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.elvador.desktop",
    "productName": "Elvador",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon-512.png",
        "to": "icon-512.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "talhaturkman",
      "repo": "elvador-desktop"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Elvador",
      "runAfterFinish": true
    }
  }
}
